# Copy this file to .env.local and fill in real values (get them at
# sanity.io/manage after creating a free project). .env.local is
# git-ignored — never commit real credentials.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only Sanity token with write access (sanity/lib/writeClient.ts).
# Needed for newsletter signups (app/api/newsletter/route.ts) and the
# scripts/seed-*.mjs scripts. Create one at sanity.io/manage > your project
# > API > Tokens > Add API token, with "Editor" permissions.
SANITY_API_TOKEN=

# Contact form (app/api/contact/route.ts). Get a free API key at
# resend.com — sign up, then Dashboard > API Keys > Create API Key.
# CONTACT_TO_EMAIL is where form submissions get sent. Until cairlab.org
# is verified as a domain in Resend, you can only send TO the email
# address you signed up to Resend with.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# The site's real deployed domain, no trailing slash (e.g. https://cairlab.org).
# Used to build absolute URLs in the sitemap, robots.txt, and social share
# preview (Open Graph) tags. Defaults to https://cairlab.org if unset.
NEXT_PUBLIC_SITE_URL=

# Password for /send-newsletter (app/api/send-newsletter/route.ts). There's
# no user-account system on this site, so this is a shared secret rather
# than a real login — pick something only you know.
NEWSLETTER_ADMIN_PASSWORD=

# Shared secret for the Sanity webhook that rebuilds pages as soon as
# content is published (app/api/revalidate/route.ts). Make up a long random
# string, put it here AND in the webhook's "Secret" field at sanity.io/manage
# > API > Webhooks. Without it, changes still appear — just up to a minute later.
SANITY_REVALIDATE_SECRET=

# AI for Professionals registration (app/initiatives/ai-for-professionals)
# sends its emails (approval requests to employers, updates to staff) from
# the CAIRLab Gmail account. GMAIL_APP_PASSWORD is NOT the normal password:
# turn on 2-Step Verification on that Google account, then create one at
# myaccount.google.com/apppasswords (16 characters, paste without spaces).
# Approval links use NEXT_PUBLIC_SITE_URL above, so make sure it's the real
# address (https://cairlab.knust.edu.gh) on the server.
GMAIL_USER=
GMAIL_APP_PASSWORD=
